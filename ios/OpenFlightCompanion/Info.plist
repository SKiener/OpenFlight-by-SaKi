<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OpenFlight</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.example.openflight</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openflight</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OpenFlight verbindet sich im WLAN mit deinem Launch-Monitor.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>OpenFlight nutzt deinen Standort, um das Wetter an der Range abzurufen. Daraus berechnet der Launch-Monitor die Luftdichte für die Flugweite.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenFlight nimmt das Treffgeräusch auf, um den Zeitpunkt des Ballkontakts genau zu bestimmen.</string>
	<key>NSMotionUsageDescription</key>
	<string>OpenFlight liest den Luftdruck aus dem Barometer des iPhones und speichert ihn neben den Wetterdaten.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresPersistentWiFi</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
